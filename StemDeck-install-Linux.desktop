#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=StemDeck Installer
Comment=Install, update, or uninstall StemDeck
Icon=system-software-install
Terminal=true
Exec=bash -c 'mkdir -p "$HOME/.local/bin"; curl -fsSL https://raw.githubusercontent.com/MetalMan1245/stemdeck/refs/heads/main/stemdeck-install_remote.sh -o "$HOME/.local/bin/stemdeck-install_remote.sh" && chmod +x "$HOME/.local/bin/stemdeck-install_remote.sh" && "$HOME/.local/bin/stemdeck-install_remote.sh"; echo; read -p "Press Enter to close..."'
Categories=Utility;
